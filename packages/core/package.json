{
  "name": "@qduc/agent-core",
  "version": "0.1.0",
  "description": "Headless session runtime and provider registries for agent applications",
  "license": "MIT",
  "author": "qduc",
  "repository": {
    "type": "git",
    "url": "https://github.com/qduc/agent-runtime.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@anthropic-ai/sandbox-runtime": "^0.0.56",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@qduc/web-fetch": "^0.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node-forge": "^1.3.14",
    "ai": "^6.0.177",
    "better-sqlite3": "^12.4.1",
    "env-paths": "^3.0.0",
    "fast-deep-equal": "^3.1.3",
    "ignore": "^5.3.2",
    "jiti": "^2.7.0",
    "openai": "^6.9.1",
    "ssh2": "^1.17.0",
    "unbash": "^3.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
