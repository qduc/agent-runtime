{
  "name": "@qduc/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Graduated @qduc agent ecosystem packages",
  "license": "MIT",
  "author": "qduc",
  "repository": {
    "type": "git",
    "url": "https://github.com/qduc/agent-runtime.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && cross-env NODE_ENV=test vitest run --config vitest.config.ts",
    "smoke": "node scripts/agent-package-smoke.mjs",
    "smoke:checkout": "node scripts/clean-checkout-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
